{
    "name": "renfordt/colors",
    "description": "A php library to convert and modify colors.",
    "type": "library",
    "require": {
        "php": "^8.4",
        "renfordt/clamp": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2",
        "symfony/var-dumper": "^7.3",
        "laravel/pint": "^1.25",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Renfordt\\Colors\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Jannik Renfordt",
            "email": "jannik.renfordt@ikobb.de"
        }
    ],
    "minimum-stability": "stable",
    "scripts": {
        "refacto": "rector",
        "lint": "pint",
        "test:refacto": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "phpunit",
        "test": [
            "@test:refacto",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
